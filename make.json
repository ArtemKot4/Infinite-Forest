{
	"$schema": "https://raw.githubusercontent.com/zheka2304/innercore-mod-toolchain/develop/toolchain/schemas/make.schema.json",
	"resources": [
		{
			"type": "minecraft_resource_pack",
			"path": "minecraft_packs/infinite_forest_resources"
		},
	    {
			"type": "minecraft_behavior_pack",
			"path": "minecraft_packs/infinite_forest_behavior"
		},
		{
			"path": "assets",
			"type": "resource_directory"
		},
		{
			"path": "assets/gui",
			"type": "gui"
		}
	],
	"project": {
		"composite": false
	},
	"sources": [
		{
			"source": "code",
			"target": "main.js",
			"type": "main",
			"language": "typescript"
		},
		{
			"source": "launcher.js",
			"type": "launcher",
			"language": "javascript"
		},
		{
			"source": "library/*",
			"type": "library",
			"language": "typescript"
		}
	],
	"additional": [
		{
			"source": "config.json",
			"targetDir": "."
		},
		{
			"source": "config.info.json",
			"targetDir": "."
		}
	],
	"info": {
		"name": "Infinite Forest",
		"author": "ArtemKot",
		"version": "2025",
		"description": "Перед вами будет простираться бескрайний лес, сопровождая вас величайшими деревьями, а в самой дали, светлячки осветят вам путь 🌟.\nЭтот мод является обновлением для мода Infinite Forest 2018 года. Мод имеет много интересных систем, проработанный мир и хорошую визуальную составляющую.\n\nВ густых лесах живут не сны, а лишь кошмары.",
		"icon": "mod_icon.png"
	},
	"api": "CoreEngine",
    "pushTo": "storage/emulated/0/games/horizon/packs/Test Pack For Developing/modpacks/La Fortezza Infinita/mods/InfiniteForest",
	"linkNative": [
		"minecraftpe",
		"innercore",
		"nativejs"
	],
	"excludeFromRelease": [],
    "tsconfig": {
        "jsx": "react",
        "jsxFactory": "UI.JSX.parseElement",
        "jsxFragmentFactory": "UI.JSX.Fragment",
		
        "strict": false,
		"strictNullChecks": false,
		"ignoreDeprecations": "6.0",
		"downlevelIteration": false
    }
}




















